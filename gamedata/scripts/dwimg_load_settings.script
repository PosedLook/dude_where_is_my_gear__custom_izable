	end
	if dwimg_main.config.exemption_device == 1 then
		dwimg_items.rule_a_prot[dwimg_lists.item_type.UPGRADED] = true
	elseif dwimg_main.config.exemption_device == 2 then
		dwimg_items.rule_b_prot[dwimg_lists.item_type.UPGRADED] = true
	end
	if dwimg_main.config.exemption_kit == 1 then
		dwimg_items.rule_a_prot[dwimg_lists.item_type.KIT] = true
	elseif dwimg_main.config.exemption_kit == 2 then
		dwimg_items.rule_b_prot[dwimg_lists.item_type.KIT] = true
	end
	if dwimg_main.config.exemption_tools == 1 then
		dwimg_items.rule_a_prot[dwimg_lists.item_type.TOOL] = true
	elseif dwimg_main.config.exemption_tools == 2 then
		dwimg_items.rule_b_prot[dwimg_lists.item_type.TOOL] = true
	end
	if dwimg_main.config.exemption_explosives == 1 then
		dwimg_items.rule_a_prot[dwimg_lists.item_type.EXPLOSIVE] = true
	elseif dwimg_main.config.exemption_explosives == 2 then
		dwimg_items.rule_b_prot[dwimg_lists.item_type.EXPLOSIVE] = true
	end
	if dwimg_main.config.exemption_ammo == 1 then
		dwimg_items.rule_a_prot[dwimg_lists.item_type.AMMO] = true
	elseif dwimg_main.config.exemption_ammo == 2 then
		dwimg_items.rule_b_prot[dwimg_lists.item_type.AMMO] = true
	end
	if dwimg_main.config.exemption_medics == 1 then
		dwimg_items.rule_a_prot[dwimg_lists.item_type.MEDICAL] = true
	elseif dwimg_main.config.exemption_medics == 2 then
		dwimg_items.rule_b_prot[dwimg_lists.item_type.MEDICAL] = true
